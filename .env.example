# ==========================================
# Nexus-7 Engine API Configuration
# ==========================================
# Base URL of the remote Nexus-7 Python Engine running on Render
VITE_ENGINE_API_URL=https://nexus7-engine.onrender.com
# NEXT_PUBLIC_ENGINE_API_URL=https://nexus7-engine.onrender.com

# Bearer Token for authenticating API requests sent to the Engine API
VITE_ENGINE_TOKEN=your_engine_bearer_token_here
# NEXT_PUBLIC_ENGINE_TOKEN=your_engine_bearer_token_here

# Legacy Vite variable fallback
VITE_ENGINE_API_TOKEN=your_engine_bearer_token_here

# ==========================================
# Supabase Configuration (Optional)
# ==========================================
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
