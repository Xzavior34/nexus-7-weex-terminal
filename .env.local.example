# Copy to .env.local for local dev. On Vercel or Render, set these under
# Project Settings -> Environment Variables.
#
# ⚠️ SECURITY: VITE_* variables are bundled into client-side JS.
# Treat VITE_ENGINE_TOKEN as effectively public once deployed.

VITE_ENGINE_API_URL=https://nexus7-engine.onrender.com
VITE_ENGINE_TOKEN=same_value_as_API_AUTH_TOKEN_on_the_engine
VITE_ENGINE_API_TOKEN=same_value_as_API_AUTH_TOKEN_on_the_engine

# Next.js equivalents if using Next.js framework
# NEXT_PUBLIC_ENGINE_API_URL=https://nexus7-engine.onrender.com
# NEXT_PUBLIC_ENGINE_TOKEN=same_value_as_API_AUTH_TOKEN_on_the_engine

# Existing Supabase config
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
