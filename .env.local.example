# Copy to .env.local for local dev. On Vercel, set these under
# Project Settings -> Environment Variables.
#
# ⚠️ SECURITY: VITE_* variables are bundled into client-side JS and are
# visible to anyone who views source / opens devtools on your deployed site.
# This is a known, deliberate tradeoff for this project (see
# src/lib/engineApi.ts for the full reasoning) — not an oversight. Treat
# VITE_ENGINE_API_TOKEN as effectively public once deployed, and see the
# engine's README for how to add a server-side proxy later if you want real
# access control instead.

VITE_ENGINE_API_URL=https://your-engine.onrender.com
VITE_ENGINE_API_TOKEN=same_value_as_API_AUTH_TOKEN_on_the_engine

# Existing Supabase config (unrelated to the trading engine — kept for
# whatever auth/other features you're using Supabase for)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
